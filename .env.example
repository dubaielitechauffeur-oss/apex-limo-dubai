# Database — PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/apex_limo_dubai?schema=public"

# Shadow database, used by `prisma migrate dev` and `prisma migrate diff`.
# Only needed for local schema work and by the CI drift check — never at runtime.
SHADOW_DATABASE_URL=

# Max Postgres connections PER APPLICATION INSTANCE (default 5). On serverless
# every warm instance holds its own pool, so total usage is this × instances —
# raise it only for a long-running container, and check it against the
# database's own max_connections.
DATABASE_POOL_MAX=

# Resend (https://resend.com) — sends booking/quote lead notification emails
# to ops, plus the customer's own confirmation email for every booking,
# quote and contact submission (two sends per submission).
# Requires a verified sending domain (apexchauffeurdubai.com) in the Resend
# dashboard before this key will work in production. Also used to deliver
# admin password-reset emails (lib/auth/email.ts).
RESEND_API_KEY=

# Auth.js (NextAuth v5) — encrypts/signs admin session cookies. Required in
# production (Auth.js throws on boot without it). Generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# Admin bootstrap — set both to seed one initial super_admin user via
# `npm run db:seed`. Leave unset to skip; re-running seed never overwrites
# an already-created account's password.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=

# WhatsApp Business Cloud API — sends the ops team a WhatsApp message for
# every new booking/quote/contact lead (lib/notifications.ts). Optional: with
# any of the three required values missing the channel skips itself and leads
# still arrive by email.
#
# Business-initiated messages must use an APPROVED TEMPLATE, so create one in
# WhatsApp Manager with exactly four body parameters, in this order:
#   {{1}} reference  {{2}} customer name  {{3}} customer phone  {{4}} detail
# then put its name in WHATSAPP_TEMPLATE_NAME.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
# Template's language code — defaults to "en" when unset.
WHATSAPP_TEMPLATE_LOCALE=
# Where to send the notification. Defaults to the admin-managed WhatsApp
# number in Settings; set this to override. Digits only, no "+".
WHATSAPP_RECIPIENT=

# CRM sync — POSTs each lead as JSON to any inbound webhook (HubSpot, Zoho,
# Salesforce, Zapier, Make, n8n). Optional: unset means the channel skips
# itself. CRM_WEBHOOK_TOKEN is sent as `Authorization: Bearer <token>` and is
# only needed if the endpoint requires it.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Previously undocumented — both are required for features that silently fail
# without them.
# ─────────────────────────────────────────────────────────────────────────────

# Vercel Blob — REQUIRED in production for the admin Media Library. Without it
# every image upload fails, with nothing in the UI pointing at the cause.
# Provided automatically when a Blob store is linked to the Vercel project.
BLOB_READ_WRITE_TOKEN=

# Shared secret for POST /api/admin/migrate (sent as the `x-migrate-secret`
# header) — an alternative to a signed-in super_admin session, for CLI use.
# That endpoint includes a DESTRUCTIVE action (`resync-images` drops and
# rebuilds every vehicle gallery), so treat this like a password. Leave unset
# to allow session-authenticated super_admins only, which is the safer default.
MIGRATE_SECRET=

# Google Analytics 4 measurement ID. Falls back to the production property when
# unset — set it explicitly on preview/staging so those deployments do not
# report into production analytics.
NEXT_PUBLIC_GA_ID=

# Canonical origin used to build password-reset links. Auth.js sets AUTH_URL on
# most platforms; when neither is present the site URL in lib/constants.ts is
# used. Deliberately NOT derived from the request Host header, which an
# attacker can influence to redirect a reset token to their own domain.
AUTH_URL=

# Legacy alias for AUTH_URL, still read as a fallback for deployments that
# predate the Auth.js v5 rename. Set one or the other, not both.
NEXTAUTH_URL=
