# Database — PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/apex_limo_dubai?schema=public"

# Resend (https://resend.com) — sends booking/quote lead notification emails
# to ops, plus the customer's own confirmation email for every booking,
# quote and contact submission (two sends per submission).
# Requires a verified sending domain (apexchauffeurdubai.com) in the Resend
# dashboard before this key will work in production. Also used to deliver
# admin password-reset emails (lib/auth/email.ts).
RESEND_API_KEY=

# Auth.js (NextAuth v5) — encrypts/signs admin session cookies. Required in
# production (Auth.js throws on boot without it). Generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# Admin bootstrap — set both to seed one initial super_admin user via
# `npm run db:seed`. Leave unset to skip; re-running seed never overwrites
# an already-created account's password.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=

# WhatsApp Business Cloud API — sends the ops team a WhatsApp message for
# every new booking/quote/contact lead (lib/notifications.ts). Optional: with
# any of the three required values missing the channel skips itself and leads
# still arrive by email.
#
# Business-initiated messages must use an APPROVED TEMPLATE, so create one in
# WhatsApp Manager with exactly four body parameters, in this order:
#   {{1}} reference  {{2}} customer name  {{3}} customer phone  {{4}} detail
# then put its name in WHATSAPP_TEMPLATE_NAME.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
# Template's language code — defaults to "en" when unset.
WHATSAPP_TEMPLATE_LOCALE=
# Where to send the notification. Defaults to the admin-managed WhatsApp
# number in Settings; set this to override. Digits only, no "+".
WHATSAPP_RECIPIENT=

# CRM sync — POSTs each lead as JSON to any inbound webhook (HubSpot, Zoho,
# Salesforce, Zapier, Make, n8n). Optional: unset means the channel skips
# itself. CRM_WEBHOOK_TOKEN is sent as `Authorization: Bearer <token>` and is
# only needed if the endpoint requires it.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_TOKEN=
