# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo

/lib/generated/prisma

# uploaded media (local storage driver) — never committed; production
# deployments configure the S3/R2 driver instead (see MEDIA_LIBRARY.md)
/storage/media/*
!/storage/media/.gitkeep

# local one-off/scratch scripts (image resizing, data backfills) — kept out
# of the repo deliberately. Anything meant to be shared belongs in
# package.json's scripts or prisma/, both of which are tracked.
scripts/

# python bytecode from the seo-agent scripts
__pycache__/
*.py[cod]
