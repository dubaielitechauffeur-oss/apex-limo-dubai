{
  "buildCommand": "node build-tools/build-with-retry.mjs",
  "redirects": [
    {
      "source": "/services/airport-transfer",
      "destination": "/services/airport-transfers",
      "permanent": true
    },
    {
      "source": "/:locale(ar|ru|zh|fr|de)/services/airport-transfer",
      "destination": "/:locale/services/airport-transfers",
      "permanent": true
    }
  ]
}
